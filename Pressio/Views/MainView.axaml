<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pressio.ViewModels"
             xmlns:conv="using:Pressio.Converters"
             xmlns:m="using:Pressio.Models"
             x:Class="Pressio.Views.MainView"
             x:DataType="vm:MainViewModel">
  <UserControl.Resources>
    <conv:ColorMatchConverter x:Key="ColorMatchConverter" />
  </UserControl.Resources>
  <Design.DataContext><vm:MainViewModel /></Design.DataContext>
  <Grid Background="{DynamicResource PressioBackgroundBrush}" RowDefinitions="Auto,*">
    <Border Background="{DynamicResource PressioSurfaceBrush}" Padding="20,16" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="12">
        <StackPanel Spacing="3">
          <TextBlock Text="PRESSIO" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PressioPrimaryBrush}" />
          <TextBlock Text="Acompanhamento da pressão" FontWeight="SemiBold" FontSize="22" Foreground="{DynamicResource PressioTextBrush}" />
        </StackPanel>
        <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Left" ItemHeight="36" Orientation="Horizontal">
          <ComboBox ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}" DisplayMemberBinding="{Binding DisplayName}" Width="200" Margin="0,0,10,0" />
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
            <Button Classes="icon-button" ToolTip.Tip="Adicionar paciente" Command="{Binding ShowPatientFormCommand}"><PathIcon Data="M12,5A3,3 0 1,1 12,11A3,3 0 0,1 12,5M12,13C15.3,13 18,14.35 18,16V18H6V16C6,14.35 8.7,13 12,13M19,8V5H17V8H14V10H17V13H19V10H22V8H19Z" /></Button>
            <Button Classes="icon-button" ToolTip.Tip="Editar paciente" Command="{Binding EditPatientCommand}"><PathIcon Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z" /></Button>
            <Button Classes="icon-button danger" ToolTip.Tip="Excluir paciente" Command="{Binding DeletePatientCommand}"><PathIcon Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" /></Button>
          </StackPanel>
          <Rectangle Width="1" Height="24" Fill="{DynamicResource PressioBorderBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Classes="icon-button" ToolTip.Tip="Lembretes" Command="{Binding ShowRemindersCommand}"><PathIcon Data="M12,22A2,2 0 0,0 14,20H10A2,2 0 0,0 12,22M18,16V11C18,7.93 16.36,5.36 13.5,4.68V4A1.5,1.5 0 0,0 12,2.5A1.5,1.5 0 0,0 10.5,4V4.68C7.63,5.36 6,7.92 6,11V16L4,18V19H20V18L18,16Z" /></Button>
          <Button Classes="icon-button" ToolTip.Tip="Aparência" Command="{Binding ShowSettingsCommand}"><PathIcon Data="M12,3A9,9 0 0,0 12,21C13.1,21 14,20.1 14,19C14,18.5 13.8,18.1 13.5,17.8C13.2,17.5 13,17.1 13,16.6C13,15.5 13.9,14.6 15,14.6H17C19.2,14.6 21,12.8 21,10.5C21,6.4 17,3 12,3M6.5,12C5.7,12 5,11.3 5,10.5C5,9.7 5.7,9 6.5,9C7.3,9 8,9.7 8,10.5C8,11.3 7.3,12 6.5,12M9.5,7C8.7,7 8,6.3 8,5.5C8,4.7 8.7,4 9.5,4C10.3,4 11,4.7 11,5.5C11,6.3 10.3,7 9.5,7M14.5,7C13.7,7 13,6.3 13,5.5C13,4.7 13.7,4 14.5,4C15.3,4 16,4.7 16,5.5C16,6.3 15.3,7 14.5,7Z" /></Button>
        </WrapPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsDesktopLayout}" HorizontalScrollBarVisibility="Disabled">
      <Grid MaxWidth="1120" HorizontalAlignment="Center" Margin="28" RowDefinitions="Auto,Auto,*" ColumnDefinitions="360,*" ColumnSpacing="24" RowSpacing="24">
        <StackPanel Grid.Column="0" Spacing="16">
          <StackPanel Spacing="2"><TextBlock Text="PACIENTE ATIVO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding PatientName}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /></StackPanel>
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
            <StackPanel Spacing="5"><TextBlock Text="ÚLTIMA PRESSÃO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding LastReading}" FontSize="46" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding LastReadingDetails}" FontSize="12" Foreground="{DynamicResource PressioPrimaryBrush}" TextWrapping="Wrap" /></StackPanel>
          </Border>
          <Button Classes="primary-button" Content="+ Registrar nova medição" Command="{Binding ShowMeasurementFormCommand}" Padding="14" HorizontalContentAlignment="Center" />
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
            <StackPanel><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Medições recentes" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><Button Classes="icon-button" ToolTip.Tip="Editar medição" Command="{Binding EditMeasurementCommand}"><PathIcon Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z" /></Button><Button Classes="icon-button danger" ToolTip.Tip="Excluir medição" Command="{Binding DeleteMeasurementCommand}"><PathIcon Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19H18V7M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" /></Button></StackPanel></Grid>
            <WrapPanel Margin="0,12,0,0"><ComboBox ItemsSource="{Binding FilterPeriodOptions}" SelectedItem="{Binding FilterPeriod}" MinWidth="120" Margin="0,0,8,8" /><ComboBox ItemsSource="{Binding FilterMedicationOptions}" SelectedItem="{Binding FilterMedication}" MinWidth="120" Margin="0,0,8,8" /><ComboBox ItemsSource="{Binding FilterTimeOfDayOptions}" SelectedItem="{Binding FilterTimeOfDay}" MinWidth="110" Margin="0,0,8,8" /><TextBox Text="{Binding FilterSearch}" PlaceholderText="Buscar em observações" MinWidth="150" Margin="0,0,8,8" /><Button Classes="secondary-button" Content="Limpar" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,8" /></WrapPanel>
            <ListBox ItemsSource="{Binding Measurements}" SelectedItem="{Binding SelectedMeasurement}" Margin="0,12,0,0" MaxHeight="270">
              <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><TextBlock Text="{Binding DisplayValue}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayDate}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding DisplayNotes}" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DisplayContext}" FontSize="11" Foreground="{DynamicResource PressioPrimaryBrush}" IsVisible="{Binding HasContext}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DisplayExtra}" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" IsVisible="{Binding HasExtra}" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="16">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="5"><TextBlock Text="MÉDIA DO HISTÓRICO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding AverageReading}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="mmHg" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></Border>
            <Border Grid.Column="1" Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="5"><TextBlock Text="TOTAL DE MEDIÇÕES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding MeasurementCount}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding WeeklySummary}" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" /></StackPanel></Border>
          </Grid>
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Evolução da pressão" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Grid.Column="1" Text="Histórico completo" FontSize="12" Foreground="{DynamicResource PressioPrimaryBrush}" /></Grid><Grid Width="500" Height="150"><Canvas ClipToBounds="True"><Line StartPoint="0,138" EndPoint="500,138" Stroke="{DynamicResource PressioBorderBrush}" StrokeThickness="1" /><Line StartPoint="0,80" EndPoint="500,80" Stroke="{DynamicResource PressioBorderBrush}" StrokeThickness="1" /><Path Data="{Binding SystolicLine}" Stroke="{DynamicResource PressioPrimaryBrush}" StrokeThickness="3" /><Path Data="{Binding DiastolicLine}" Stroke="{DynamicResource PressioMutedBrush}" StrokeThickness="2" /></Canvas><ItemsControl ItemsSource="{Binding ChartLabels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:ChartPointLabel"><TextBlock Text="{Binding Text}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" Margin="{Binding Offset}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid><StackPanel Orientation="Horizontal" Spacing="14"><StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="10" Height="3" Fill="{DynamicResource PressioPrimaryBrush}" VerticalAlignment="Center" /><TextBlock Text="Pressão maior" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="10" Height="3" Fill="{DynamicResource PressioMutedBrush}" VerticalAlignment="Center" /><TextBlock Text="Pressão menor" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></StackPanel><TextBlock Text="As linhas acompanham a pressão maior e a menor em cada aferição." FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></Border>
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Medicação" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="3"><TextBlock Text="Antes" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding BeforeMedicationSummary}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Depois" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding AfterMedicationSummary}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" TextWrapping="Wrap" /></StackPanel></Grid></StackPanel></Border>
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Distribuição por horário" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><ItemsControl ItemsSource="{Binding TimeDistribution}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:TimeSlotInfo"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Fatores associados" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><ItemsControl ItemsSource="{Binding ContextCounts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:ContextCountInfo"><Border Background="{DynamicResource PressioBackgroundBrush}" CornerRadius="12" Padding="10,5" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding Count}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PressioPrimaryBrush}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          <Border Background="{DynamicResource PressioBannerBrush}" CornerRadius="16" Padding="22"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="Relatório do paciente" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PressioBannerTextBrush}" /><TextBlock Text="Exporte o histórico para compartilhar em uma consulta." FontSize="12" Foreground="{DynamicResource PressioBannerTextBrush}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Vertical" Spacing="8" HorizontalAlignment="Right"><ComboBox ItemsSource="{Binding ReportPeriodOptions}" SelectedItem="{Binding ReportPeriod}" MinWidth="160" Foreground="{DynamicResource PressioBannerTextBrush}" /><StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomReportPeriod}"><CalendarDatePicker SelectedDate="{Binding ReportStartDate}" PlaceholderText="De" MinWidth="120" /><CalendarDatePicker SelectedDate="{Binding ReportEndDate}" PlaceholderText="Até" MinWidth="120" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="primary-button" Content="Exportar PDF" Command="{Binding ExportPdfCommand}" Padding="14,9" /><Button Classes="primary-button" Content="Exportar CSV" Command="{Binding ExportCsvCommand}" Padding="14,9" /></StackPanel></StackPanel></Grid></Border>
          <TextBlock Text="{Binding ExportStatus}" FontSize="11" Foreground="{DynamicResource PressioPrimaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

      </Grid>
    </ScrollViewer>

    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsMobileLayout}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20" Spacing="16">
        <StackPanel Spacing="2">
          <TextBlock Text="PACIENTE ATIVO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PressioMutedBrush}" />
          <TextBlock Text="{Binding PatientName}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" />
        </StackPanel>
        <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
          <StackPanel Spacing="5"><TextBlock Text="ÚLTIMA PRESSÃO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding LastReading}" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding LastReadingDetails}" FontSize="12" Foreground="{DynamicResource PressioPrimaryBrush}" TextWrapping="Wrap" /></StackPanel>
        </Border>
        <Button Classes="primary-button" Content="+ Registrar nova medição" Command="{Binding ShowMeasurementFormCommand}" Padding="14" HorizontalContentAlignment="Center" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16"><StackPanel Spacing="4"><TextBlock Text="MÉDIA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding AverageReading}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="mmHg" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></Border>
          <Border Grid.Column="1" Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16"><StackPanel Spacing="4"><TextBlock Text="MEDIÇÕES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding MeasurementCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding WeeklySummary}" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" /></StackPanel></Border>
        </Grid>
        <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
          <StackPanel Spacing="10"><TextBlock Text="Evolução da pressão" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><Viewbox Stretch="Uniform" Height="150"><Grid Width="500" Height="150"><Canvas ClipToBounds="True"><Line StartPoint="0,138" EndPoint="500,138" Stroke="{DynamicResource PressioBorderBrush}" StrokeThickness="1" /><Line StartPoint="0,80" EndPoint="500,80" Stroke="{DynamicResource PressioBorderBrush}" StrokeThickness="1" /><Path Data="{Binding SystolicLine}" Stroke="{DynamicResource PressioPrimaryBrush}" StrokeThickness="3" /><Path Data="{Binding DiastolicLine}" Stroke="{DynamicResource PressioMutedBrush}" StrokeThickness="2" /></Canvas><ItemsControl ItemsSource="{Binding ChartLabels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:ChartPointLabel"><TextBlock Text="{Binding Text}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" Margin="{Binding Offset}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Viewbox><StackPanel Orientation="Horizontal" Spacing="14"><StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="10" Height="3" Fill="{DynamicResource PressioPrimaryBrush}" VerticalAlignment="Center" /><TextBlock Text="Pressão maior" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="10" Height="3" Fill="{DynamicResource PressioMutedBrush}" VerticalAlignment="Center" /><TextBlock Text="Pressão menor" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></StackPanel><TextBlock Text="As linhas acompanham a pressão maior e a menor em cada aferição." FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel>
        </Border>
        <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18"><StackPanel Spacing="10"><TextBlock Text="Medicação" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="3"><TextBlock Text="Antes" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding BeforeMedicationSummary}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Depois" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding AfterMedicationSummary}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" TextWrapping="Wrap" /></StackPanel></Grid></StackPanel></Border>
        <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
          <StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Medições recentes" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button Classes="icon-button" ToolTip.Tip="Editar medição" Command="{Binding EditMeasurementCommand}"><PathIcon Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z" /></Button><Button Classes="icon-button danger" ToolTip.Tip="Excluir medição" Command="{Binding DeleteMeasurementCommand}"><PathIcon Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19H18V7M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" /></Button></StackPanel></Grid><WrapPanel Margin="0,12,0,0"><ComboBox ItemsSource="{Binding FilterPeriodOptions}" SelectedItem="{Binding FilterPeriod}" MinWidth="140" Margin="0,0,8,8" /><ComboBox ItemsSource="{Binding FilterMedicationOptions}" SelectedItem="{Binding FilterMedication}" MinWidth="140" Margin="0,0,8,8" /><ComboBox ItemsSource="{Binding FilterTimeOfDayOptions}" SelectedItem="{Binding FilterTimeOfDay}" MinWidth="130" Margin="0,0,8,8" /><TextBox Text="{Binding FilterSearch}" PlaceholderText="Buscar em observações" MinWidth="180" Margin="0,0,8,8" /><Button Classes="secondary-button" Content="Limpar" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,8" /></WrapPanel><ListBox ItemsSource="{Binding Measurements}" SelectedItem="{Binding SelectedMeasurement}" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><TextBlock Text="{Binding DisplayValue}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayDate}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding DisplayNotes}" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DisplayContext}" FontSize="11" Foreground="{DynamicResource PressioPrimaryBrush}" IsVisible="{Binding HasContext}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DisplayExtra}" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" IsVisible="{Binding HasExtra}" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
        </Border>
        <StackPanel Spacing="10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"><ComboBox ItemsSource="{Binding ReportPeriodOptions}" SelectedItem="{Binding ReportPeriod}" MinWidth="160" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding IsCustomReportPeriod}"><CalendarDatePicker SelectedDate="{Binding ReportStartDate}" PlaceholderText="De" MinWidth="150" /><CalendarDatePicker SelectedDate="{Binding ReportEndDate}" PlaceholderText="Até" MinWidth="150" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"><Button Classes="secondary-button" Content="Exportar PDF" Command="{Binding ExportPdfCommand}" Padding="14" /><Button Classes="secondary-button" Content="Exportar CSV" Command="{Binding ExportCsvCommand}" Padding="14" /></StackPanel></StackPanel>
        <TextBlock Text="{Binding ExportStatus}" FontSize="11" Foreground="{DynamicResource PressioPrimaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.RowSpan="2" IsVisible="{Binding IsPatientDialogVisible}" Background="#8A171A2F">
      <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PressioSurfaceBrush}" CornerRadius="18" Padding="28" BoxShadow="0 12 40 0 #40171A2F">
        <StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding PatientFormTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><Button Grid.Column="1" Classes="secondary-button" Content="Fechar" Command="{Binding CancelPatientCommand}" /></Grid><TextBlock Text="Crie ou atualize o perfil que terá suas próprias medições." FontSize="13" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" /><TextBox Text="{Binding NewPatientName}" PlaceholderText="Nome do paciente" /><TextBlock Text="{Binding PatientError}" FontSize="12" Foreground="#B42318" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Classes="secondary-button" Content="Cancelar" Command="{Binding CancelPatientCommand}" /><Button Classes="primary-button" Content="Salvar paciente" Command="{Binding SavePatientCommand}" /></StackPanel></StackPanel>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsMeasurementDialogVisible}" Background="#8A171A2F">
      <Border Width="680" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PressioSurfaceBrush}" CornerRadius="18" Padding="28" BoxShadow="0 12 40 0 #40171A2F">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="{Binding MeasurementFormTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="Digite 13/8 ou 130/80. Você pode ajustar data e horário." FontSize="13" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel><Button Grid.Column="1" Classes="secondary-button" Content="Fechar" Command="{Binding CancelMeasurementCommand}" /></Grid><TextBox Text="{Binding BloodPressureInput}" PlaceholderText="Ex.: 13/8" FontSize="24" Padding="12" /><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Data da aferição" FontSize="12" FontWeight="SemiBold" /><CalendarDatePicker SelectedDate="{Binding MeasurementDate}" PlaceholderText="Escolha a data" /></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Hora da aferição" FontSize="12" FontWeight="SemiBold" /><TimePicker SelectedTime="{Binding MeasurementTime}" ClockIdentifier="24HourClock" /></StackPanel></Grid><StackPanel Spacing="5"><TextBlock Text="Medicação" FontSize="12" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding MedicationOptions}" SelectedItem="{Binding SelectedMedicationOption}" /></StackPanel><StackPanel Spacing="6"><TextBlock Text="Contexto da aferição" FontSize="12" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding ContextOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:ContextOption"><ToggleButton Classes="toggle-chip" IsChecked="{Binding IsSelected}" Content="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel Spacing="6"><TextBlock Text="Detalhes (opcionais)" FontSize="12" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><StackPanel Spacing="4"><TextBlock Text="Frequência cardíaca (bpm)" FontSize="11" FontWeight="SemiBold" /><TextBox Text="{Binding HeartRateInput}" PlaceholderText="Ex.: 72" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Braço" FontSize="11" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding ArmOptions}" SelectedItem="{Binding SelectedArm}" /></StackPanel><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Posição" FontSize="11" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding PositionOptions}" SelectedItem="{Binding SelectedPosition}" /></StackPanel></Grid><CheckBox Content="Em repouso antes da aferição" IsChecked="{Binding AtRest}" Foreground="{DynamicResource PressioTextBrush}" /></StackPanel><TextBox Text="{Binding Notes}" PlaceholderText="Observação opcional (ex.: dor de cabeça)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" /><TextBlock Text="{Binding MeasurementError}" Foreground="#B42318" FontSize="12" TextWrapping="Wrap" /><Button Classes="secondary-button" Content="Usar câmera ou selecionar imagem" Command="{Binding ImportMeasurementImageCommand}" HorizontalAlignment="Left" /><TextBlock Text="{Binding ImageImportStatus}" Foreground="{DynamicResource PressioMutedBrush}" FontSize="11" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Classes="secondary-button" Content="Cancelar" Command="{Binding CancelMeasurementCommand}" /><Button Classes="primary-button" Content="Salvar medição" Command="{Binding SaveMeasurementCommand}" /></StackPanel></StackPanel></ScrollViewer>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsSettingsDialogVisible}" Background="#8A171A2F">
      <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PressioSurfaceBrush}" CornerRadius="18" Padding="28" BoxShadow="0 12 40 0 #40171A2F">
        <StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Aparência" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><Button Grid.Column="1" Classes="secondary-button" Content="Fechar" Command="{Binding CloseSettingsCommand}" /></Grid><StackPanel Spacing="5"><TextBlock Text="Tema" FontSize="12" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding AppearanceOptions}" SelectedItem="{Binding SelectedAppearance}" /></StackPanel><StackPanel Spacing="5"><TextBlock Text="Formato de exibição" FontSize="12" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding MeasurementDisplayFormatOptions}" SelectedItem="{Binding SelectedDisplayFormat}" /><TextBlock Text="Ex.: 13/8 ou 130/80" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel><StackPanel Spacing="8"><TextBlock Text="Cor primária" FontSize="12" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="color-swatch" Background="#5B5BD6" ToolTip.Tip="Índigo" Command="{Binding SelectPrimaryColorCommand}" CommandParameter="Índigo"><PathIcon Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" Foreground="White" IsVisible="{Binding SelectedPrimaryColor, Converter={StaticResource ColorMatchConverter}, ConverterParameter=Índigo}" /></Button><Button Classes="color-swatch" Background="#2775D8" ToolTip.Tip="Azul" Command="{Binding SelectPrimaryColorCommand}" CommandParameter="Azul"><PathIcon Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" Foreground="White" IsVisible="{Binding SelectedPrimaryColor, Converter={StaticResource ColorMatchConverter}, ConverterParameter=Azul}" /></Button><Button Classes="color-swatch" Background="#16846F" ToolTip.Tip="Verde" Command="{Binding SelectPrimaryColorCommand}" CommandParameter="Verde"><PathIcon Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" Foreground="White" IsVisible="{Binding SelectedPrimaryColor, Converter={StaticResource ColorMatchConverter}, ConverterParameter=Verde}" /></Button><Button Classes="color-swatch" Background="#7954C8" ToolTip.Tip="Roxo" Command="{Binding SelectPrimaryColorCommand}" CommandParameter="Roxo"><PathIcon Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" Foreground="White" IsVisible="{Binding SelectedPrimaryColor, Converter={StaticResource ColorMatchConverter}, ConverterParameter=Roxo}" /></Button><Button Classes="color-swatch" Background="#D65B54" ToolTip.Tip="Coral" Command="{Binding SelectPrimaryColorCommand}" CommandParameter="Coral"><PathIcon Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" Foreground="White" IsVisible="{Binding SelectedPrimaryColor, Converter={StaticResource ColorMatchConverter}, ConverterParameter=Coral}" /></Button></StackPanel><TextBlock Text="O tema e a cor são aplicados ao clicar em Aplicar." FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel><Border Background="#EEF0FF" CornerRadius="10" Padding="14"><TextBlock Text="A cor selecionada é indicada pela marcação dentro do círculo." Foreground="{DynamicResource PressioPrimaryBrush}" FontSize="12" TextWrapping="Wrap" /></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Classes="secondary-button" Content="Cancelar" Command="{Binding CloseSettingsCommand}" /><Button Classes="primary-button" Content="Aplicar" Command="{Binding SaveSettingsCommand}" /></StackPanel></StackPanel>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsMeasurementMobilePageVisible}" Background="{DynamicResource PressioSurfaceBrush}" RowDefinitions="Auto,*">
      <Border Padding="20,16" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="Auto,*"><Button Classes="secondary-button" Content="← Voltar" Command="{Binding CancelMeasurementCommand}" /><StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="2"><TextBlock Text="{Binding MeasurementFormTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="Registre sua aferição" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></Grid></Border>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20" Spacing="16"><TextBlock Text="Digite 13/8 ou 130/80" FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" /><TextBox Text="{Binding BloodPressureInput}" PlaceholderText="Ex.: 13/8" FontSize="26" Padding="14" /><StackPanel Spacing="6"><TextBlock Text="Data da aferição" FontWeight="SemiBold" /><CalendarDatePicker SelectedDate="{Binding MeasurementDate}" PlaceholderText="Escolha a data" /></StackPanel><StackPanel Spacing="6"><TextBlock Text="Hora da aferição" FontWeight="SemiBold" /><TimePicker SelectedTime="{Binding MeasurementTime}" ClockIdentifier="24HourClock" /></StackPanel><StackPanel Spacing="6"><TextBlock Text="Medicação" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding MedicationOptions}" SelectedItem="{Binding SelectedMedicationOption}" /></StackPanel><StackPanel Spacing="6"><TextBlock Text="Contexto da aferição" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding ContextOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:ContextOption"><ToggleButton Classes="toggle-chip" IsChecked="{Binding IsSelected}" Content="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel Spacing="6"><TextBlock Text="Detalhes (opcionais)" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="4"><TextBlock Text="Frequência cardíaca (bpm)" FontSize="11" FontWeight="SemiBold" /><TextBox Text="{Binding HeartRateInput}" PlaceholderText="Ex.: 72" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Braço" FontSize="11" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding ArmOptions}" SelectedItem="{Binding SelectedArm}" /></StackPanel></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0"><StackPanel Grid.Column="0" Spacing="4"><TextBlock Text="Posição" FontSize="11" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding PositionOptions}" SelectedItem="{Binding SelectedPosition}" /></StackPanel><CheckBox Grid.Column="1" Content="Em repouso" IsChecked="{Binding AtRest}" VerticalAlignment="Bottom" Margin="0,0,0,8" Foreground="{DynamicResource PressioTextBrush}" /></Grid></StackPanel><TextBox Text="{Binding Notes}" PlaceholderText="Observação opcional (ex.: dor de cabeça)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" /><TextBlock Text="{Binding MeasurementError}" Foreground="#B42318" TextWrapping="Wrap" /><Button Classes="secondary-button" Content="Usar câmera ou selecionar imagem" Command="{Binding ImportMeasurementImageCommand}" HorizontalAlignment="Left" /><TextBlock Text="{Binding ImageImportStatus}" Foreground="{DynamicResource PressioMutedBrush}" FontSize="11" TextWrapping="Wrap" /><Button Classes="primary-button" Content="Salvar medição" Command="{Binding SaveMeasurementCommand}" HorizontalContentAlignment="Center" Padding="16" /></StackPanel></ScrollViewer>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsPatientMobilePageVisible}" Background="{DynamicResource PressioSurfaceBrush}" RowDefinitions="Auto,*">
      <Border Padding="20,16" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="Auto,*"><Button Classes="secondary-button" Content="← Voltar" Command="{Binding CancelPatientCommand}" /><StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="2"><TextBlock Text="{Binding PatientFormTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="Dados do paciente" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></Grid></Border>
      <StackPanel Grid.Row="1" Margin="20" Spacing="16"><TextBox Text="{Binding NewPatientName}" PlaceholderText="Nome do paciente" /><TextBlock Text="{Binding PatientError}" Foreground="#B42318" TextWrapping="Wrap" /><Button Classes="primary-button" Content="Salvar paciente" Command="{Binding SavePatientCommand}" HorizontalContentAlignment="Center" Padding="16" /></StackPanel>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsSettingsMobilePageVisible}" Background="{DynamicResource PressioSurfaceBrush}" RowDefinitions="Auto,*">
      <Border Padding="20,16" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="Auto,*"><Button Classes="secondary-button" Content="← Voltar" Command="{Binding CloseSettingsCommand}" /><StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="2"><TextBlock Text="Aparência" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="Tema e cor de destaque" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></Grid></Border>
      <StackPanel Grid.Row="1" Margin="20" Spacing="16"><StackPanel Spacing="6"><TextBlock Text="Tema" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding AppearanceOptions}" SelectedItem="{Binding SelectedAppearance}" /></StackPanel><StackPanel Spacing="6"><TextBlock Text="Formato de exibição" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding MeasurementDisplayFormatOptions}" SelectedItem="{Binding SelectedDisplayFormat}" /><TextBlock Text="Ex.: 13/8 ou 130/80" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel><StackPanel Spacing="8"><TextBlock Text="Cor primária" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="10"><Button Classes="color-swatch" Width="38" Height="38" Background="#5B5BD6" CornerRadius="19" ToolTip.Tip="Índigo" Command="{Binding SelectPrimaryColorCommand}" CommandParameter="Índigo"><PathIcon Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" Foreground="White" IsVisible="{Binding SelectedPrimaryColor, Converter={StaticResource ColorMatchConverter}, ConverterParameter=Índigo}" /></Button><Button Classes="color-swatch" Width="38" Height="38" Background="#2775D8" CornerRadius="19" ToolTip.Tip="Azul" Command="{Binding SelectPrimaryColorCommand}" CommandParameter="Azul"><PathIcon Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" Foreground="White" IsVisible="{Binding SelectedPrimaryColor, Converter={StaticResource ColorMatchConverter}, ConverterParameter=Azul}" /></Button><Button Classes="color-swatch" Width="38" Height="38" Background="#16846F" CornerRadius="19" ToolTip.Tip="Verde" Command="{Binding SelectPrimaryColorCommand}" CommandParameter="Verde"><PathIcon Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" Foreground="White" IsVisible="{Binding SelectedPrimaryColor, Converter={StaticResource ColorMatchConverter}, ConverterParameter=Verde}" /></Button><Button Classes="color-swatch" Width="38" Height="38" Background="#7954C8" CornerRadius="19" ToolTip.Tip="Roxo" Command="{Binding SelectPrimaryColorCommand}" CommandParameter="Roxo"><PathIcon Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" Foreground="White" IsVisible="{Binding SelectedPrimaryColor, Converter={StaticResource ColorMatchConverter}, ConverterParameter=Roxo}" /></Button><Button Classes="color-swatch" Width="38" Height="38" Background="#D65B54" CornerRadius="19" ToolTip.Tip="Coral" Command="{Binding SelectPrimaryColorCommand}" CommandParameter="Coral"><PathIcon Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" Foreground="White" IsVisible="{Binding SelectedPrimaryColor, Converter={StaticResource ColorMatchConverter}, ConverterParameter=Coral}" /></Button></StackPanel></StackPanel><Button Classes="primary-button" Content="Aplicar" Command="{Binding SaveSettingsCommand}" HorizontalContentAlignment="Center" Padding="16" /></StackPanel>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsRemindersDialogVisible}" Background="#8A171A2F">
      <Border Width="520" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PressioSurfaceBrush}" CornerRadius="18" Padding="24" BoxShadow="0 12 40 0 #40171A2F">
        <StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Lembretes" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><Button Grid.Column="1" Classes="secondary-button" Content="Fechar" Command="{Binding CloseRemindersCommand}" /></Grid><TextBlock Text="Defina horários recorrentes para aferir a pressão. O aviso aparece enquanto o app está aberto." FontSize="13" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" /><Button Classes="primary-button" Content="+ Novo lembrete" Command="{Binding ShowReminderFormCommand}" HorizontalContentAlignment="Center" /><ListBox ItemsSource="{Binding Reminders}" SelectedItem="{Binding SelectedReminder}" MaxHeight="280"><ListBox.ItemTemplate><DataTemplate x:DataType="m:ReminderItem"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="4,6"><TextBlock Text="{Binding DisplayTime}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayDays}" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip.Tip="Ativo" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Classes="secondary-button" Content="Editar" Command="{Binding EditReminderCommand}" /><Button Classes="danger-button" Content="Excluir" Command="{Binding DeleteReminderCommand}" /></StackPanel></StackPanel>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsReminderFormDialogVisible}" Background="#8A171A2F">
      <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PressioSurfaceBrush}" CornerRadius="18" Padding="24" BoxShadow="0 12 40 0 #40171A2F">
        <StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Lembrete" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><Button Grid.Column="1" Classes="secondary-button" Content="Fechar" Command="{Binding CancelReminderFormCommand}" /></Grid><StackPanel Spacing="5"><TextBlock Text="Horário" FontSize="12" FontWeight="SemiBold" /><TimePicker SelectedTime="{Binding ReminderTime}" ClockIdentifier="24HourClock" /></StackPanel><StackPanel Spacing="6"><TextBlock Text="Dias da semana" FontSize="12" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding ReminderDayOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:ReminderDayOption"><ToggleButton Classes="toggle-chip" IsChecked="{Binding IsSelected}" Content="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><CheckBox Content="Lembrete ativo" IsChecked="{Binding ReminderEnabled}" Foreground="{DynamicResource PressioTextBrush}" /><TextBox Text="{Binding ReminderNote}" PlaceholderText="Observação (opcional)" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Classes="secondary-button" Content="Cancelar" Command="{Binding CancelReminderFormCommand}" /><Button Classes="primary-button" Content="Salvar lembrete" Command="{Binding SaveReminderCommand}" /></StackPanel></StackPanel>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsRemindersMobilePageVisible}" Background="{DynamicResource PressioSurfaceBrush}" RowDefinitions="Auto,*">
      <Border Padding="20,16" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="Auto,*"><Button Classes="secondary-button" Content="← Voltar" Command="{Binding CloseRemindersCommand}" /><StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="2"><TextBlock Text="Lembretes" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="Horários recorrentes de aferição" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></Grid></Border>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20" Spacing="16"><Button Classes="primary-button" Content="+ Novo lembrete" Command="{Binding ShowReminderFormCommand}" HorizontalContentAlignment="Center" /><ListBox ItemsSource="{Binding Reminders}" SelectedItem="{Binding SelectedReminder}" MaxHeight="300"><ListBox.ItemTemplate><DataTemplate x:DataType="m:ReminderItem"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="4,6"><TextBlock Text="{Binding DisplayTime}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayDays}" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip.Tip="Ativo" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="secondary-button" Content="Editar" Command="{Binding EditReminderCommand}" /><Button Classes="danger-button" Content="Excluir" Command="{Binding DeleteReminderCommand}" /></StackPanel></StackPanel></ScrollViewer>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsReminderFormMobilePageVisible}" Background="{DynamicResource PressioSurfaceBrush}" RowDefinitions="Auto,*">
      <Border Padding="20,16" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="Auto,*"><Button Classes="secondary-button" Content="← Voltar" Command="{Binding CancelReminderFormCommand}" /><StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="2"><TextBlock Text="Lembrete" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="Novo horário recorrente" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></Grid></Border>
      <StackPanel Grid.Row="1" Margin="20" Spacing="16"><StackPanel Spacing="6"><TextBlock Text="Horário" FontWeight="SemiBold" /><TimePicker SelectedTime="{Binding ReminderTime}" ClockIdentifier="24HourClock" /></StackPanel><StackPanel Spacing="6"><TextBlock Text="Dias da semana" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding ReminderDayOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:ReminderDayOption"><ToggleButton Classes="toggle-chip" IsChecked="{Binding IsSelected}" Content="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><CheckBox Content="Lembrete ativo" IsChecked="{Binding ReminderEnabled}" Foreground="{DynamicResource PressioTextBrush}" /><TextBox Text="{Binding ReminderNote}" PlaceholderText="Observação (opcional)" /><Button Classes="primary-button" Content="Salvar lembrete" Command="{Binding SaveReminderCommand}" HorizontalContentAlignment="Center" Padding="16" /></StackPanel>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsConfirmDialogVisible}" Background="#8A171A2F">
      <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PressioSurfaceBrush}" CornerRadius="18" Padding="28" BoxShadow="0 12 40 0 #40171A2F">
        <StackPanel Spacing="14"><TextBlock Text="Confirmar exclusão" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding ConfirmMessage}" FontSize="13" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Classes="secondary-button" Content="Cancelar" Command="{Binding CancelDeleteCommand}" /><Button Classes="danger-button" Content="Excluir" Command="{Binding ConfirmDeleteCommand}" /></StackPanel></StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
