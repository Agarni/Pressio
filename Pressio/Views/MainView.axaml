    <Grid Grid.RowSpan="2" IsVisible="{Binding IsAboutDialogVisible}" Background="#8A171A2F">
      <Border Width="460" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PressioSurfaceBrush}" CornerRadius="20" Padding="30" BoxShadow="0 12 40 0 #40171A2F">
        <StackPanel Spacing="14" HorizontalAlignment="Center">
          <Border Width="92" Height="92" CornerRadius="22" ClipToBounds="True"><Image Source="avares://Pressio/Assets/Icon.png" Stretch="Fill" /></Border>
          <TextBlock Text="Pressio" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="Acompanhe sua pressão arterial de forma simples e segura, em qualquer dispositivo." FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
          <Border Height="1" Background="{DynamicResource PressioBorderBrush}" Width="300" Margin="0,6" />
          <TextBlock Text="Desenvolvido por Sérgio Luiz" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="E-mail: sergio_luiz@outlook.com" FontSize="13" Foreground="{DynamicResource PressioMutedBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="WhatsApp: (16) 99181-3623" FontSize="13" Foreground="{DynamicResource PressioMutedBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="Versão 1.0" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
          <Button Classes="primary-button" Content="Fechar" Command="{Binding CloseAboutCommand}" HorizontalContentAlignment="Center" IsVisible="{Binding IsAboutCloseVisible}" />
        </StackPanel>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsAboutMobilePageVisible}" Background="{DynamicResource PressioBackgroundBrush}" RowDefinitions="Auto,*">
      <Border Padding="20,16" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="Auto,*"><Button Classes="icon-button" ToolTip.Tip="Voltar" Command="{Binding CloseAboutCommand}"><PathIcon Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" /></Button><TextBlock Grid.Column="1" Text="Sobre" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" Margin="16,8,0,0" /></Grid></Border>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="92" Height="92" CornerRadius="22" ClipToBounds="True"><Image Source="avares://Pressio/Assets/Icon.png" Stretch="Fill" /></Border>
        <TextBlock Text="Pressio" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="Acompanhe sua pressão arterial de forma simples e segura, em qualquer dispositivo." FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
        <Border Height="1" Background="{DynamicResource PressioBorderBrush}" Width="300" Margin="0,6" />
        <TextBlock Text="Desenvolvido por Sérgio Luiz" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="E-mail: sergio_luiz@outlook.com" FontSize="13" Foreground="{DynamicResource PressioMutedBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="WhatsApp: (16) 99181-3623" FontSize="13" Foreground="{DynamicResource PressioMutedBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="Versão 1.0" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
        <Button Classes="primary-button" Content="Fechar" Command="{Binding CloseAboutCommand}" HorizontalContentAlignment="Center" Padding="16" IsVisible="{Binding IsAboutCloseVisible}" />
      </StackPanel></ScrollViewer>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsConfirmDialogVisible}" Background="#8A171A2F">
      <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PressioSurfaceBrush}" CornerRadius="18" Padding="28" BoxShadow="0 12 40 0 #40171A2F">
        <StackPanel Spacing="14"><TextBlock Text="Confirmar exclusão" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding ConfirmMessage}" FontSize="13" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Classes="secondary-button" Content="Cancelar" Command="{Binding CancelDeleteCommand}" /><Button Classes="danger-button" Content="Excluir" Command="{Binding ConfirmDeleteCommand}" /></StackPanel></StackPanel>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding Dialog.IsVisible}" Background="#8A171A2F">
      <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PressioSurfaceBrush}" CornerRadius="18" Padding="28" BoxShadow="0 12 40 0 #40171A2F">
        <StackPanel Spacing="14"><TextBlock Text="{Binding Dialog.Title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding Dialog.Message}" FontSize="13" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Classes="secondary-button" Content="{Binding Dialog.CancelText}" Command="{Binding Dialog.CancelCommand}" IsVisible="{Binding Dialog.IsCancelVisible}" /><Button Classes="primary-button" Content="{Binding Dialog.ConfirmText}" Command="{Binding Dialog.OkCommand}" /></StackPanel></StackPanel>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsSyncNotifierVisible}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0">
      <Border Background="#D64545" CornerRadius="14" Padding="16,10" BoxShadow="0 6 24 0 #40171A2F" IsVisible="{Binding SyncNotifierIsError}">
        <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="M13,14H11V9H13M13,18H11V16H13M1,21H23L12,2L1,21Z" Foreground="White" /><TextBlock Text="{Binding SyncNotifier}" FontSize="13" Foreground="White" /></StackPanel>
      </Border>
      <Border Background="{DynamicResource PressioBannerBrush}" CornerRadius="14" Padding="16,10" BoxShadow="0 6 24 0 #40171A2F" IsVisible="{Binding !SyncNotifierIsError}">
        <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="M19.35,10.04C18.67,6.74 15.8,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14C0,17.31 2.69,20 6,20H19C21.76,20 24,17.76 24,15C24,12.36 21.95,10.22 19.35,10.04Z" Foreground="{DynamicResource PressioBannerTextBrush}" /><TextBlock Text="{Binding SyncNotifier}" FontSize="13" Foreground="{DynamicResource PressioBannerTextBrush}" /></StackPanel>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsSplashVisible}" Background="{DynamicResource PressioBackgroundBrush}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <Border Width="96" Height="96" CornerRadius="24" ClipToBounds="True" HorizontalAlignment="Center"><Image Source="avares://Pressio/Assets/Icon.png" Stretch="Fill" /></Border>
        <TextBlock Text="Pressio" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="Acompanhe sua pressão arterial" FontSize="15" Foreground="{DynamicResource PressioMutedBrush}" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,20,0,0" IsVisible="{Binding HasSplashMessage}">
          <PathIcon Data="M19.35,10.04C18.67,6.74 15.8,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14C0,17.31 2.69,20 6,20H19C21.76,20 24,17.76 24,15C24,12.36 21.95,10.22 19.35,10.04Z" Foreground="{DynamicResource PressioPrimaryBrush}" />
          <TextBlock Text="{Binding SplashMessage}" FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
  </Border>
</UserControl>
