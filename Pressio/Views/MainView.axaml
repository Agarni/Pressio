      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20" Spacing="16"><Button Classes="primary-button" Content="+ Novo lembrete" Command="{Binding ShowReminderFormCommand}" HorizontalContentAlignment="Center" /><ListBox ItemsSource="{Binding Reminders}" SelectedItem="{Binding SelectedReminder}" MaxHeight="300"><ListBox.ItemTemplate><DataTemplate x:DataType="m:ReminderItem"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="4,6"><TextBlock Text="{Binding DisplayTime}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayDays}" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip.Tip="Ativo" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="icon-button" ToolTip.Tip="Editar lembrete" Command="{Binding EditReminderCommand}"><PathIcon Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z" /></Button><Button Classes="icon-button danger" ToolTip.Tip="Excluir lembrete" Command="{Binding DeleteReminderCommand}"><PathIcon Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" /></Button></StackPanel></StackPanel></ScrollViewer>
