        <StackPanel Spacing="14"><TextBlock Text="Lembrete de aferição" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding ReminderNoticeMessage}" FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" /><Button Classes="primary-button" Content="OK" Command="{Binding DismissReminderNoticeCommand}" HorizontalContentAlignment="Center" /></StackPanel>
      </Border>
