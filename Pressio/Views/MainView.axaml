<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pressio.ViewModels"
             xmlns:conv="using:Pressio.Converters"
             xmlns:m="using:Pressio.Models"
             x:Class="Pressio.Views.MainView"
             x:DataType="vm:MainViewModel"
             TopLevel.AutoSafeAreaPadding="False">
  <UserControl.Resources>
    <conv:ColorMatchConverter x:Key="ColorMatchConverter" />
    <conv:CategoryColorConverter x:Key="CatColor" />
    <conv:CorrelationColorConverter x:Key="CorrColor" />
  </UserControl.Resources>
  <Design.DataContext><vm:MainViewModel /></Design.DataContext>
  <Border x:Name="Root" Background="{DynamicResource PressioBackgroundBrush}">
    <Grid RowDefinitions="Auto,*">
    <Border Background="{DynamicResource PressioSurfaceBrush}" Padding="20,16" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="12">
        <StackPanel Spacing="3">
          <TextBlock Text="PRESSIO" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PressioPrimaryBrush}" />
          <TextBlock Text="Acompanhamento da pressão" FontWeight="SemiBold" FontSize="22" Foreground="{DynamicResource PressioTextBrush}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center" HorizontalAlignment="Stretch">
          <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="12" HorizontalAlignment="Left" Command="{Binding ShowProfileListCommand}" ToolTip.Tip="Usuários">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource PressioPrimaryBrush}">
                <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="USUÁRIO ATIVO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PressioMutedBrush}" />
                <TextBlock Text="{Binding PatientName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" />
              </StackPanel>
              <PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Foreground="{DynamicResource PressioMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Rectangle Grid.Column="1" Width="1" Height="24" Fill="{DynamicResource PressioBorderBrush}" VerticalAlignment="Center" Margin="2,0" />
          <Button Grid.Column="2" Classes="icon-button" AutomationProperties.Name="Lembretes" ToolTip.Tip="Lembretes" Command="{Binding ShowRemindersCommand}"><PathIcon Data="M12,22A2,2 0 0,0 14,20H10A2,2 0 0,0 12,22M18,16V11C18,7.93 16.36,5.36 13.5,4.68V4A1.5,1.5 0 0,0 12,2.5A1.5,1.5 0 0,0 10.5,4V4.68C7.63,5.36 6,7.92 6,11V16L4,18V19H20V18L18,16Z" /></Button>
          <Button Grid.Column="3" Classes="icon-button" AutomationProperties.Name="Configurações" ToolTip.Tip="Configurações" Command="{Binding ShowSettingsCommand}"><PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" /></Button>
          <Button Grid.Column="4" Classes="icon-button" AutomationProperties.Name="Sobre" ToolTip.Tip="Sobre" Command="{Binding ShowAboutCommand}"><PathIcon Data="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" /></Button>
        </Grid>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsDesktopLayout}" HorizontalScrollBarVisibility="Disabled">
      <Grid MaxWidth="1120" HorizontalAlignment="Center" Margin="28" RowDefinitions="Auto,Auto,*" ColumnDefinitions="360,*" ColumnSpacing="24" RowSpacing="24">
        <StackPanel Grid.Column="0" Spacing="16">
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
            <StackPanel Spacing="5"><TextBlock Text="ÚLTIMA PRESSÃO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding LastReading}" FontSize="46" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" /><Border Background="{Binding LastReadingCategory, Converter={StaticResource CatColor}}" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" IsVisible="{Binding HasReadings}" VerticalAlignment="Center"><TextBlock Text="{Binding LastReadingCategoryLabel}" FontSize="11" FontWeight="Bold" Foreground="White" /></Border><TextBlock Text="{Binding LastReadingDetails}" FontSize="12" Foreground="{DynamicResource PressioPrimaryBrush}" TextWrapping="Wrap" /></StackPanel>
          </Border>
          <Button Classes="primary-button" Content="+ Registrar nova medição" Command="{Binding ShowMeasurementFormCommand}" Padding="14" HorizontalContentAlignment="Center" />
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
            <StackPanel><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Medições recentes" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><Button Classes="icon-button" ToolTip.Tip="Editar medição" Command="{Binding EditMeasurementCommand}"><PathIcon Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z" /></Button><Button Classes="icon-button danger" ToolTip.Tip="Excluir medição" Command="{Binding DeleteMeasurementCommand}"><PathIcon Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19H18V7M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" /></Button></StackPanel></Grid>
            <WrapPanel Margin="0,12,0,0"><ComboBox ItemsSource="{Binding FilterPeriodOptions}" SelectedItem="{Binding FilterPeriod}" MinWidth="120" Margin="0,0,8,8" /><ComboBox ItemsSource="{Binding FilterMedicationOptions}" SelectedItem="{Binding FilterMedication}" MinWidth="120" Margin="0,0,8,8" /><ComboBox ItemsSource="{Binding FilterTimeOfDayOptions}" SelectedItem="{Binding FilterTimeOfDay}" MinWidth="110" Margin="0,0,8,8" /><TextBox Text="{Binding FilterSearch}" PlaceholderText="Buscar em observações" MinWidth="150" Margin="0,0,8,8" /><Button Classes="secondary-button" Content="Limpar" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,8" /></WrapPanel>
            <ListBox ItemsSource="{Binding Measurements}" SelectedItem="{Binding SelectedMeasurement}" Margin="0,12,0,0" MaxHeight="270">
              <ListBox.ItemTemplate><DataTemplate x:DataType="m:BloodPressureMeasurement"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><StackPanel Grid.Column="0" Spacing="5"><TextBlock Text="{Binding DisplayValue}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" VerticalAlignment="Center" /><Border Background="{Binding Category, Converter={StaticResource CatColor}}" CornerRadius="8" Padding="8,2" HorizontalAlignment="Left"><TextBlock Text="{Binding CategoryLabel}" FontSize="10" FontWeight="Bold" Foreground="White" /></Border></StackPanel><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayDate}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding DisplayNotes}" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DisplayContext}" FontSize="11" Foreground="{DynamicResource PressioPrimaryBrush}" IsVisible="{Binding HasContext}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DisplayExtra}" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" IsVisible="{Binding HasExtra}" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="16">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="5"><TextBlock Text="MÉDIA DO HISTÓRICO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding AverageReading}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="mmHg" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></Border>
            <Border Grid.Column="1" Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="5"><TextBlock Text="TOTAL DE MEDIÇÕES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding MeasurementCount}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding WeeklySummary}" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" /></StackPanel></Border>
          </Grid>
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Evolução da pressão" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Grid.Column="1" Text="Histórico completo" FontSize="12" Foreground="{DynamicResource PressioPrimaryBrush}" /></Grid><Grid Width="500" Height="150"><Canvas ClipToBounds="True"><Line StartPoint="0,138" EndPoint="500,138" Stroke="{DynamicResource PressioBorderBrush}" StrokeThickness="1" /><Line StartPoint="0,80" EndPoint="500,80" Stroke="{DynamicResource PressioBorderBrush}" StrokeThickness="1" /><Path Data="{Binding SystolicLine}" Stroke="{DynamicResource PressioPrimaryBrush}" StrokeThickness="3" /><Path Data="{Binding DiastolicLine}" Stroke="{DynamicResource PressioMutedBrush}" StrokeThickness="2" /></Canvas><ItemsControl ItemsSource="{Binding ChartLabels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:ChartPointLabel"><TextBlock Text="{Binding Text}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" Margin="{Binding Offset}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid><StackPanel Orientation="Horizontal" Spacing="14"><StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="10" Height="3" Fill="{DynamicResource PressioPrimaryBrush}" VerticalAlignment="Center" /><TextBlock Text="Pressão maior" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="10" Height="3" Fill="{DynamicResource PressioMutedBrush}" VerticalAlignment="Center" /><TextBlock Text="Pressão menor" FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></StackPanel><TextBlock Text="As linhas acompanham a pressão maior e a menor em cada aferição." FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></Border>
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Medicação" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="3"><TextBlock Text="Antes" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding BeforeMedicationSummary}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Depois" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding AfterMedicationSummary}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" TextWrapping="Wrap" /></StackPanel></Grid></StackPanel></Border>
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Médias por horário" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><ItemsControl ItemsSource="{Binding TimeDistribution}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:TimeSlotInfo"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding AverageText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding Count, StringFormat='{}{0}x'}" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Correlações" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="Diferença da média de pressão nos registros com cada fator, em relação aos sem o fator." FontSize="11" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" /><ItemsControl ItemsSource="{Binding Correlations}" IsVisible="{Binding HasCorrelations}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:CorrelationInfo"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource PressioTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding Delta}" FontSize="13" FontWeight="Bold" Foreground="{Binding Raises, Converter={StaticResource CorrColor}}" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Faça pelo menos 3 aferições com e sem o fator para ver a correlação." FontSize="10" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" IsVisible="{Binding !HasCorrelations}" /></StackPanel></Border>
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><StackPanel Spacing="10"><TextBlock Text="Fatores associados" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><ItemsControl ItemsSource="{Binding ContextCounts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:ContextCountInfo"><Border Background="{DynamicResource PressioBackgroundBrush}" CornerRadius="12" Padding="10,5" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding Count}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PressioPrimaryBrush}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          <Border Background="{DynamicResource PressioBannerBrush}" CornerRadius="16" Padding="22"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="Relatório do usuário" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PressioBannerTextBrush}" /><TextBlock Text="Exporte o histórico para compartilhar em uma consulta." FontSize="12" Foreground="{DynamicResource PressioBannerTextBrush}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Vertical" Spacing="8" HorizontalAlignment="Right"><ComboBox ItemsSource="{Binding ReportPeriodOptions}" SelectedItem="{Binding ReportPeriod}" MinWidth="160" Foreground="{DynamicResource PressioBannerTextBrush}" /><StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomReportPeriod}"><CalendarDatePicker SelectedDate="{Binding ReportStartDate}" PlaceholderText="De" MinWidth="120" /><CalendarDatePicker SelectedDate="{Binding ReportEndDate}" PlaceholderText="Até" MinWidth="120" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="primary-button" Content="Carta ao médico" Command="{Binding ExportLetterCommand}" Padding="14,9" /><Button Classes="primary-button" Content="Exportar PDF" Command="{Binding ExportPdfCommand}" Padding="14,9" /><Button Classes="primary-button" Content="Exportar CSV" Command="{Binding ExportCsvCommand}" Padding="14,9" /></StackPanel></StackPanel></Grid></Border>
        </StackPanel>

      </Grid>
    </ScrollViewer>

    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsMobileLayout}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20" Spacing="16">
        <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
          <StackPanel Spacing="5"><TextBlock Text="ÚLTIMA PRESSÃO" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding LastReading}" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" /><Border Background="{Binding LastReadingCategory, Converter={StaticResource CatColor}}" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" IsVisible="{Binding HasReadings}" VerticalAlignment="Center"><TextBlock Text="{Binding LastReadingCategoryLabel}" FontSize="12" FontWeight="Bold" Foreground="White" /></Border><TextBlock Text="{Binding LastReadingDetails}" FontSize="14" Foreground="{DynamicResource PressioPrimaryBrush}" TextWrapping="Wrap" /></StackPanel>
        </Border>
        <Button Classes="primary-button" Content="+ Registrar nova medição" Command="{Binding ShowMeasurementFormCommand}" Padding="14" HorizontalContentAlignment="Center" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16"><StackPanel Spacing="4"><TextBlock Text="MÉDIA" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding AverageReading}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="mmHg" FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></Border>
          <Border Grid.Column="1" Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16"><StackPanel Spacing="4"><TextBlock Text="MEDIÇÕES" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding MeasurementCount}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding WeeklySummary}" FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" /></StackPanel></Border>
        </Grid>
        <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
          <StackPanel Spacing="10"><TextBlock Text="Evolução da pressão" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><Viewbox Stretch="Uniform" Height="150"><Grid Width="500" Height="150"><Canvas ClipToBounds="True"><Line StartPoint="0,138" EndPoint="500,138" Stroke="{DynamicResource PressioBorderBrush}" StrokeThickness="1" /><Line StartPoint="0,80" EndPoint="500,80" Stroke="{DynamicResource PressioBorderBrush}" StrokeThickness="1" /><Path Data="{Binding SystolicLine}" Stroke="{DynamicResource PressioPrimaryBrush}" StrokeThickness="3" /><Path Data="{Binding DiastolicLine}" Stroke="{DynamicResource PressioMutedBrush}" StrokeThickness="2" /></Canvas><ItemsControl ItemsSource="{Binding ChartLabels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:ChartPointLabel"><TextBlock Text="{Binding Text}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" Margin="{Binding Offset}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Viewbox><StackPanel Orientation="Horizontal" Spacing="14"><StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="10" Height="3" Fill="{DynamicResource PressioPrimaryBrush}" VerticalAlignment="Center" /><TextBlock Text="Pressão maior" FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="10" Height="3" Fill="{DynamicResource PressioMutedBrush}" VerticalAlignment="Center" /><TextBlock Text="Pressão menor" FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></StackPanel><TextBlock Text="As linhas acompanham a pressão maior e a menor em cada aferição." FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel>
        </Border>
        <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18"><StackPanel Spacing="10"><TextBlock Text="Medicação" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="3"><TextBlock Text="Antes" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding BeforeMedicationSummary}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Depois" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding AfterMedicationSummary}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" TextWrapping="Wrap" /></StackPanel></Grid></StackPanel></Border>
        <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18"><StackPanel Spacing="10"><TextBlock Text="Médias por horário" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><ItemsControl ItemsSource="{Binding TimeDistribution}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:TimeSlotInfo"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Label}" FontSize="16" Foreground="{DynamicResource PressioMutedBrush}" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding AverageText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="{Binding Count, StringFormat='{}{0}x'}" FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18"><StackPanel Spacing="10"><TextBlock Text="Correlações" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><TextBlock Text="Diferença da média de pressão nos registros com cada fator, em relação aos sem o fator." FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" /><ItemsControl ItemsSource="{Binding Correlations}" IsVisible="{Binding HasCorrelations}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:CorrelationInfo"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Label}" FontSize="16" Foreground="{DynamicResource PressioTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding Delta}" FontSize="17" FontWeight="Bold" Foreground="{Binding Raises, Converter={StaticResource CorrColor}}" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Faça pelo menos 3 aferições com e sem o fator para ver a correlação." FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" IsVisible="{Binding !HasCorrelations}" /></StackPanel></Border>
        <Border Background="{DynamicResource PressioSurfaceBrush}" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
          <StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Medições recentes" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PressioTextBrush}" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button Classes="icon-button" ToolTip.Tip="Editar medição" Command="{Binding EditMeasurementCommand}"><PathIcon Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z" /></Button><Button Classes="icon-button danger" ToolTip.Tip="Excluir medição" Command="{Binding DeleteMeasurementCommand}"><PathIcon Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19H18V7M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" /></Button></StackPanel></Grid><WrapPanel Margin="0,12,0,0"><ComboBox ItemsSource="{Binding FilterPeriodOptions}" SelectedItem="{Binding FilterPeriod}" MinWidth="140" Margin="0,0,8,8" /><ComboBox ItemsSource="{Binding FilterMedicationOptions}" SelectedItem="{Binding FilterMedication}" MinWidth="140" Margin="0,0,8,8" /><ComboBox ItemsSource="{Binding FilterTimeOfDayOptions}" SelectedItem="{Binding FilterTimeOfDay}" MinWidth="130" Margin="0,0,8,8" /><TextBox Text="{Binding FilterSearch}" PlaceholderText="Buscar em observações" MinWidth="180" Margin="0,0,8,8" /><Button Classes="secondary-button" Content="Limpar" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,8" /></WrapPanel><ListBox ItemsSource="{Binding Measurements}" SelectedItem="{Binding SelectedMeasurement}" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate x:DataType="m:BloodPressureMeasurement"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><StackPanel Grid.Column="0" Spacing="5"><TextBlock Text="{Binding DisplayValue}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PressioTextBrush}" VerticalAlignment="Center" /><Border Background="{Binding Category, Converter={StaticResource CatColor}}" CornerRadius="8" Padding="8,2" HorizontalAlignment="Left"><TextBlock Text="{Binding CategoryLabel}" FontSize="12" FontWeight="Bold" Foreground="White" /></Border></StackPanel><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayDate}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PressioMutedBrush}" /><TextBlock Text="{Binding DisplayNotes}" FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DisplayContext}" FontSize="14" Foreground="{DynamicResource PressioPrimaryBrush}" IsVisible="{Binding HasContext}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DisplayExtra}" FontSize="14" Foreground="{DynamicResource PressioMutedBrush}" IsVisible="{Binding HasExtra}" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
        </Border>
        <StackPanel Spacing="10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"><ComboBox ItemsSource="{Binding ReportPeriodOptions}" SelectedItem="{Binding ReportPeriod}" MinWidth="160" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding IsCustomReportPeriod}"><CalendarDatePicker SelectedDate="{Binding ReportStartDate}" PlaceholderText="De" MinWidth="150" /><CalendarDatePicker SelectedDate="{Binding ReportEndDate}" PlaceholderText="Até" MinWidth="150" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"><Button Classes="secondary-button" Content="Carta ao médico" Command="{Binding ExportLetterCommand}" Padding="14" /><Button Classes="secondary-button" Content="Exportar PDF" Command="{Binding ExportPdfCommand}" Padding="14" /><Button Classes="secondary-button" Content="Exportar CSV" Command="{Binding ExportCsvCommand}" Padding="14" /></StackPanel></StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.RowSpan="2" IsVisible="{Binding IsPatientDialogVisible}" Background="#8A171A2F">
      <Border Width="480" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PressioSurfaceBrush}" CornerRadius="18" BoxShadow="0 12 40 0 #40171A2F">
