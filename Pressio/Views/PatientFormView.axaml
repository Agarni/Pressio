<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pressio.ViewModels"
             xmlns:conv="using:Pressio.Converters"
             x:Class="Pressio.Views.PatientFormView"
             x:DataType="vm:PatientFormViewModel">
  <UserControl.Resources>
    <conv:MobileFontSizeConverter x:Key="Mob" />
  </UserControl.Resources>
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer x:Name="FormScroll" Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14" Margin="20,16,20,16">
        <TextBlock Text="Crie ou atualize o perfil que terá suas próprias medições." FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=13;1.8}" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" />
        <TextBox x:Name="PatientNameInput" Text="{Binding NewPatientName}" PlaceholderText="Nome do usuário" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=14;1.2}" />
        <TextBlock Text="{Binding PatientError}" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=12;1.8}" Foreground="#B42318" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12" IsVisible="{Binding !IsMobileLayout}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="secondary-button" Content="Cancelar" Command="{Binding CancelCommand}" />
        <Button Classes="primary-button" Content="Salvar usuário" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
