<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pressio.ViewModels"
             xmlns:m="using:Pressio.Models"
             xmlns:conv="using:Pressio.Converters"
             x:Class="Pressio.Views.MeasurementFormView"
             x:DataType="vm:MeasurementFormViewModel">
  <UserControl.Resources>
    <conv:MobileFontSizeConverter x:Key="Mob" />
  </UserControl.Resources>
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer x:Name="FormScroll" Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14" Margin="20,16,20,16">
        <TextBlock Text="Digite 13/8 ou 130/80. Você pode ajustar data e horário." FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=13;1.8}" Foreground="{DynamicResource PressioMutedBrush}" TextWrapping="Wrap" />
        <TextBox x:Name="PressureInput" Text="{Binding BloodPressureInput}" PlaceholderText="Ex.: 13/8" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=24;1.2}" Padding="12" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Spacing="5"><TextBlock Text="Data da aferição" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=12;1.8}" FontWeight="SemiBold" /><CalendarDatePicker SelectedDate="{Binding MeasurementDate}" PlaceholderText="Escolha a data" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=14;1.2}" /></StackPanel>
          <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Hora da aferição" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=12;1.8}" FontWeight="SemiBold" /><TimePicker SelectedTime="{Binding MeasurementTime}" ClockIdentifier="24HourClock" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=14;1.2}" /></StackPanel>
        </Grid>
        <StackPanel Spacing="5"><TextBlock Text="Medicação" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=12;1.8}" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding MedicationOptions}" SelectedItem="{Binding SelectedMedicationOption}" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=14;1.2}" /></StackPanel>
        <StackPanel Spacing="6"><TextBlock Text="Detalhes (opcionais)" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=12;1.8}" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><StackPanel Spacing="4"><TextBlock Text="Frequência cardíaca (bpm)" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=11;1.8}" FontWeight="SemiBold" /><TextBox Text="{Binding HeartRateInput}" PlaceholderText="Ex.: 72" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=14;1.2}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Braço" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=11;1.8}" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding ArmOptions}" SelectedItem="{Binding SelectedArm}" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=14;1.2}" /></StackPanel><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Posição" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=11;1.8}" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding PositionOptions}" SelectedItem="{Binding SelectedPosition}" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=14;1.2}" /></StackPanel></Grid><CheckBox Content="Em repouso antes da aferição" IsChecked="{Binding AtRest}" Foreground="{DynamicResource PressioTextBrush}" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=14;1.2}" /></StackPanel>
        <StackPanel Spacing="6"><TextBlock Text="Contexto da aferição" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=12;1.8}" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding ContextOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:ContextOption"><ToggleButton Classes="toggle-chip" IsChecked="{Binding IsSelected}" Content="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <TextBox Text="{Binding Notes}" PlaceholderText="Observação opcional (ex.: dor de cabeça)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=14;1.2}" />
        <TextBlock Text="{Binding MeasurementError}" Foreground="#B42318" FontSize="{Binding IsMobileLayout, Converter={StaticResource Mob}, ConverterParameter=12;1.8}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" BorderBrush="{DynamicResource PressioBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12" IsVisible="{Binding !IsMobileLayout}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="secondary-button" Content="Cancelar" Command="{Binding CancelCommand}" />
        <Button Classes="primary-button" Content="Salvar medição" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
