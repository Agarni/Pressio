<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Pressio</ApplicationTitle>
    <ApplicationId>agarnidev.Pressio</ApplicationId>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodesignKey>iPhone Developer</CodesignKey>
    <!-- Evita carregamento AOT prematuro de dependências reflexivas durante o desenvolvimento. -->
    <UseInterpreter>true</UseInterpreter>
    <MtouchLink>SdkOnly</MtouchLink>
    <MtouchNoSymbolStrip>true</MtouchNoSymbolStrip>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <!-- Workaround para falha de carregamento AOT observada com Xcode 26.6/.NET iOS. -->
    <MtouchNoSymbolStrip>true</MtouchNoSymbolStrip>
    <!-- Mantém todo o código gerenciado (sem trim): o app usa reflexão (ViewLocator, ReactiveUI,
         JsonSerializer). O AOT continua gerando nativo para a velocidade; só desativa a poda. -->
    <MtouchLink>SdkOnly</MtouchLink>
    <!-- Se ainda assim houver código reflexivo/dinâmico que não roda em AOT puro, o runtime
         cai para o interpretador (evita o crash nativo na inicialização). -->
    <MtouchExtraArgs>--interp</MtouchExtraArgs>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pressio\Pressio.csproj" />
  </ItemGroup>
</Project>
